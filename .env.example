# Copie para .env (na raiz) e preencha só o que for usar. O .env está no .gitignore.

# --- Blocos 1 a 5 e baseline LLM do Bloco 6 ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LANGSMITH_API_KEY=           # traces do TypeSafeClassifier (Bloco 6, módulo 02)
# LANGSMITH_TRACING=true

# --- Bloco 6: Modelos de Decisão ---
# replay (padrão): tudo sai de 06-decision-models/fixtures, sem chave e sem rede
# live: chama Jev, Laya e LLMs de verdade
# record: chama de verdade e grava as fixtures (use 05_replay_record.py)
DECISION_PROVIDER=replay

# Jev (TypeSafe AI, acesso antecipado)
TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.13.0

# Laya local: docker compose --profile decision up laya   (ou: uv run laya-serve)
# No Windows, prefira 127.0.0.1 a localhost (localhost tenta IPv6 primeiro e atrasa ~2 s).
LAYA_BASE_URL=http://127.0.0.1:8001
# LAYA_API_KEY=               # só se o servidor exigir

# Alvos das comparações e LLM de baseline (formato provedor:modelo do init_chat_model)
# DECISION_TARGETS=jev,laya,llm:anthropic:claude-haiku-4-5-20251001
# DECISION_LLM=anthropic:claude-haiku-4-5-20251001
